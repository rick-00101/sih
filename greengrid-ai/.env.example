# GreenGrid AI — Phase 2 configuration
# Copy this file to .env and adjust as needed. All values have sane
# defaults in backend/config.py, so .env is optional for a quick demo run.

# Location used for the live weather lookup (default: New Delhi)
LATITUDE=28.6139
LONGITUDE=77.2090

# Weather provider (Open-Meteo needs no API key)
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_TIMEOUT_SECONDS=5.0

# CO2 assumption used everywhere CO2-avoided is calculated — change this
# to match your local grid's actual emission factor if you have one.
GRID_EMISSION_FACTOR=0.71

# Battery model (small building scale, not the Kaggle plant scale)
BATTERY_CAPACITY_KWH=13.5
BATTERY_MIN_SOC_PCT=15.0
BATTERY_MAX_SOC_PCT=100.0
BATTERY_CHARGE_EFFICIENCY=0.92
BATTERY_DISCHARGE_EFFICIENCY=0.92
BATTERY_MAX_CHARGE_KW=5.0
BATTERY_MAX_DISCHARGE_KW=5.0

# Generic reference turbine curve, used only to estimate a wind ML model
# input at forecast time (not the exact manufacturer curve)
WIND_TURBINE_RATED_KW=3600.0
WIND_CUT_IN_MS=3.0
WIND_RATED_MS=12.0
WIND_CUT_OUT_MS=25.0

# The Kaggle-trained models are utility/plant-scale; these scale their
# output down for a small-building demo scenario (see config.py comments)
SOLAR_SCALE_FACTOR=0.001
WIND_SCALE_FACTOR=0.001
